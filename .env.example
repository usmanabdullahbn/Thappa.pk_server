# Server
# Server
# Server
# Server
# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/thappa

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# QR signing (separate secret from auth JWTs, used for Mode A dynamic stamp QR tokens)
QR_SIGNING_SECRET=change_this_qr_secret_in_production
QR_TOKEN_TTL_SECONDS=300

# Admin bootstrap (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@thappa.in
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Thappa Admin

# NOTE ON AUTH PROVIDERS
# This build ships with a self-contained OTP + email/password auth system so it
# runs with zero external accounts. Phone OTPs are generated server-side and
# logged to the console (see src/modules/auth/auth.service.ts -> sendOtp).
# Swap in Firebase Admin SDK / Google OAuth verification later by replacing
# the functions in auth.service.ts marked "// TODO: swap for Firebase".
